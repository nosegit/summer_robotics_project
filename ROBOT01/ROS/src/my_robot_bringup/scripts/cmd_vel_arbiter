#!/usr/bin/env python3

import time

import rclpy
from geometry_msgs.msg import Twist
from rclpy.node import Node


class CmdVelArbiter(Node):
    """Give parcel acquisition priority over navigation velocity commands."""

    def __init__(self):
        super().__init__('cmd_vel_arbiter')
        self.declare_parameter('navigation_topic', '/cmd_vel_navigation')
        self.declare_parameter('acquisition_topic', '/cmd_vel_acquisition')
        self.declare_parameter('output_topic', '/cmd_vel')
        self.declare_parameter('navigation_timeout', 0.5)
        self.declare_parameter('acquisition_timeout', 0.25)

        self._navigation_timeout = float(
            self.get_parameter('navigation_timeout').value
        )
        self._acquisition_timeout = float(
            self.get_parameter('acquisition_timeout').value
        )
        self._last_navigation = None
        self._last_navigation_time = None
        self._last_acquisition_time = None
        self._active_source = None

        self._publisher = self.create_publisher(
            Twist, self.get_parameter('output_topic').value, 10
        )
        self.create_subscription(
            Twist,
            self.get_parameter('navigation_topic').value,
            self._navigation_callback,
            10,
        )
        self.create_subscription(
            Twist,
            self.get_parameter('acquisition_topic').value,
            self._acquisition_callback,
            10,
        )
        self.create_timer(0.05, self._check_timeouts)

    @staticmethod
    def _now():
        # Command freshness must not stop advancing when simulation is paused.
        return time.monotonic()

    def _acquisition_is_active(self, now):
        return (
            self._last_acquisition_time is not None
            and now - self._last_acquisition_time <= self._acquisition_timeout
        )

    def _navigation_is_active(self, now):
        return (
            self._last_navigation_time is not None
            and now - self._last_navigation_time <= self._navigation_timeout
        )

    def _select(self, source, command):
        if source != self._active_source:
            self._publisher.publish(Twist())
            self._active_source = source
            self.get_logger().info(
                f'cmd_vel source: {source if source is not None else "none"}'
            )
        if command is not None:
            self._publisher.publish(command)

    def _navigation_callback(self, command):
        now = self._now()
        self._last_navigation = command
        self._last_navigation_time = now
        if not self._acquisition_is_active(now):
            self._select('navigation', command)

    def _acquisition_callback(self, command):
        self._last_acquisition_time = self._now()
        self._select('acquisition', command)

    def _check_timeouts(self):
        now = self._now()
        if self._acquisition_is_active(now):
            return
        if self._navigation_is_active(now):
            if self._active_source != 'navigation':
                self._select('navigation', self._last_navigation)
            return
        if self._active_source is not None:
            self._select(None, None)


def main(args=None):
    rclpy.init(args=args)
    node = CmdVelArbiter()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node._publisher.publish(Twist())
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
