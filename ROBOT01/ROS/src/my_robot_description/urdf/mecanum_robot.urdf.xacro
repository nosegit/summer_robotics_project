<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mecanum_robot">

    <!-- chassis properties -->
    <xacro:property name="chassis_length" value="0.35"/>  
    <xacro:property name="chassis_width"  value="0.30"/>  
    <xacro:property name="chassis_height" value="0.005"/>  
    <xacro:property name="chassis_mass"   value="0.5"/>  
    <xacro:property name="wheel_radius"   value="0.0325"/> 
    <xacro:property name="wheel_thickness" value="0.03"/> 
    <xacro:property name="wheel_mass"     value="0.1"/>  
    <xacro:property name="ground_clearance" value="0.04"/> 

    <xacro:property name="wheel_inset_x" value="0.045"/> 
    <xacro:property name="wheel_inset_y" value="0.015"/> 

    <xacro:property name="lidar_radius"     value="0.035"/>
    <xacro:property name="lidar_height"     value="0.025"/>
    <xacro:property name="lidar_mass"       value="0.2"/>
    <xacro:property name="lidar_x_offset"   value="-0.075"/>
    <!-- <xacro:property name="lidar_x_offset"   value="0.0"/> -->
    <xacro:property name="lidar_z_offset"   value="0.21"/>

    <!-- Raspberry Pi Camera Module 2 dimensions (metres). -->
    <xacro:property name="camera_width" value="0.025"/>
    <xacro:property name="camera_height" value="0.024"/>
    <xacro:property name="camera_depth" value="0.009"/>
    <xacro:property name="camera_board_depth" value="0.0016"/>
    <xacro:property name="camera_mass" value="0.01"/>
    <xacro:property name="camera_update_rate" value="30"/>
    <xacro:property name="camera_x_offset"   value="0.01"/>
    <xacro:property name="camera_y_offset"   value="${ (chassis_width/2.0) - 0.01}"/>
    <xacro:property name="camera_z_offset"   value="0.025"/>



    <xacro:property name="wheel_pos_x" value="${(chassis_length / 2.0) - wheel_inset_x}"/>
    <xacro:property name="wheel_pos_y" value="${(chassis_width / 2.0) + wheel_inset_y}"/>
    <xacro:property name="chassis_pos_z" value="${ground_clearance + (chassis_height / 2.0)}"/>
    <xacro:property name="wheel_pos_z"   value="${wheel_radius}"/>
    
    <xacro:property name="lidar_update_rate"   value="10"/>
    <xacro:property name="lidar_samples"       value="360"/>
    <xacro:property name="lidar_min_angle"     value="-3.14159"/> 
    <xacro:property name="lidar_max_angle"     value="3.14159"/>  
    <xacro:property name="lidar_min_range"     value="0.15"/>
    <xacro:property name="lidar_max_range"     value="12.0"/>
    <xacro:property name="lidar_noise_stddev"  value="0.01"/>
    
    <xacro:property name="wheelbase"        value="${wheel_pos_x * 2.0}"/> 
    <xacro:property name="wheel_separation" value="${wheel_pos_y * 2.0}"/> 

    <xacro:property name="imu_sensor_L_x_offset" value="-0.075"/>
    <xacro:property name="imu_sensor_L_y_offset" value="0.085"/>
    <xacro:property name="imu_sensor_R_x_offset" value="-0.075"/>
    <xacro:property name="imu_sensor_R_y_offset" value="0.09"/>
    <xacro:property name="imu_sensor_z_offset" value="0.2"/>


    <!-- Sim Toggle -->
    <xacro:arg name="use_sim" default="false" />

    <xacro:macro name="inertial_box" params="mass x y z">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="${mass}"/>
            <inertia ixx="${(mass/12.0) * (y*y + z*z)}" ixy="0.0" ixz="0.0"
                     iyy="${(mass/12.0) * (x*x + z*z)}" iyz="0.0"
                     izz="${(mass/12.0) * (x*x + y*y)}"/>
        </inertial>
    </xacro:macro>

    <xacro:macro name="inertial_cylinder" params="mass radius length">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="${mass}"/>
            <inertia ixx="${(mass/12.0) * (3*radius*radius + length*length)}" ixy="0.0" ixz="0.0"
                     iyy="${(mass/12.0) * (3*radius*radius + length*length)}" iyz="0.0"
                     izz="${(0.5) * mass * (radius*radius)}"/>
        </inertial>
    </xacro:macro>

    <link name="base_link"/>

    <link name="chassis">
        <visual>
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
            </geometry>
            <material name="blue"><color rgba="0.1 0.1 0.8 1.0"/></material>
        </visual>
        <collision>
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}"/>
    </link>

    <joint name="chassis_joint" type="fixed">
        <parent link="base_link"/>
        <child link="chassis"/>
        <origin xyz="0 0 ${chassis_pos_z}" rpy="0 0 0"/>
    </joint>

    <xacro:macro name="mecanum_wheel" params="prefix x_reflect y_reflect z_axis_reflect">
        <link name="${prefix}_wheel">
            <visual>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
                </geometry>
                <material name="black"><color rgba="0.0 0.0 0.0 1.0"/></material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/> 
                <geometry>
                    <sphere radius="${wheel_radius}"/>
                </geometry>
            </collision>
            <xacro:inertial_cylinder mass="${wheel_mass}" radius="${wheel_radius}" length="${wheel_thickness}"/>
        </link>

        <joint name="${prefix}_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${prefix}_wheel"/>
            <origin xyz="${x_reflect * wheel_pos_x} ${y_reflect * wheel_pos_y} ${wheel_pos_z}" rpy="0 0 0"/>
            <!-- <axis xyz="0 ${z_axis_reflect} 0"/> -->
            <axis xyz="0 1 0"/>
        </joint>
        
        <gazebo reference="${prefix}_wheel">
            <surface>
                <friction>
                    <ode>
                        <mu>0.0</mu>   <mu2>0.0</mu2>
                    </ode>
                </friction>
            </surface>
        </gazebo>
    </xacro:macro>

    <xacro:mecanum_wheel prefix="front_left"  x_reflect="1"  y_reflect="1"  z_axis_reflect="1" />
    <xacro:mecanum_wheel prefix="rear_left"   x_reflect="-1" y_reflect="1"  z_axis_reflect="1" />
    <xacro:mecanum_wheel prefix="front_right" x_reflect="1"  y_reflect="-1" z_axis_reflect="-1" />
    <xacro:mecanum_wheel prefix="rear_right"  x_reflect="-1" y_reflect="-1" z_axis_reflect="-1" />

    <!-- LIDAR -->
    <link name="laser_frame">
        <visual>
            <geometry>
                <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
            </geometry>
            <material name="red"><color rgba="0.8 0.1 0.1 1.0"/></material>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="${lidar_mass}" radius="${lidar_radius}" length="${lidar_height}"/>
    </link>

    <joint name="laser_joint" type="fixed">
        <parent link="chassis"/>
        <child link="laser_frame"/>
        <origin xyz="${lidar_x_offset} 0 ${(chassis_height/2.0) + (lidar_height/2.0) + (lidar_z_offset)}" rpy="0 0 0"/>
    </joint>

    <!-- CAMERA: +X points forward on the chassis.  The optical frame follows
         REP 103: +Z forward, +X right, +Y down. -->
    <link name="camera_link">
        <!-- The board is centred on camera_link; +X is the viewing direction. -->
        <visual>
            <origin xyz="${-(camera_depth - camera_board_depth) / 2.0} 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="${camera_board_depth} ${camera_width} ${camera_height}"/>
            </geometry>
            <material name="camera_board_green"><color rgba="0.08 0.35 0.10 1.0"/></material>
        </visual>
        <collision>
            <geometry>
                <box size="${camera_depth} ${camera_width} ${camera_height}"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="${camera_mass}" x="${camera_depth}" y="${camera_width}" z="${camera_height}"/>
    </link>

    <joint name="camera_joint" type="fixed">
        <parent link="chassis"/>
        <child link="camera_link"/>
        <origin xyz="${(camera_depth / 2.0) + camera_x_offset} ${camera_y_offset} ${chassis_height/2.0 + camera_height/2.0 + camera_z_offset}" rpy="0 0 1.5708"/>
    </joint>

    <link name="camera_optical_frame"/>
    <joint name="camera_optical_joint" type="fixed">
        <parent link="camera_link"/>
        <child link="camera_optical_frame"/>
        <origin xyz="0.0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <!-- SENSOR LINKS FOR ROS2_CONTROL -->
    <link name="imu_sensor_L"/>
    <joint name="imu_L_joint" type="fixed">
        <parent link="chassis"/>
        <child link="imu_sensor_L"/>
        <origin xyz="${imu_sensor_L_x_offset} ${imu_sensor_L_y_offset} ${imu_sensor_z_offset}" rpy="0 0 0"/>
    </joint>

    <link name="imu_sensor_R"/>
    <joint name="imu_R_joint" type="fixed">
        <parent link="chassis"/>
        <child link="imu_sensor_R"/>
        <origin xyz="${imu_sensor_R_x_offset} ${imu_sensor_R_y_offset} ${imu_sensor_z_offset}" rpy="0 0 0"/>
    </joint>
    
    <link name="ir_sensor_1"/>
    <joint name="ir_1_joint" type="fixed">
        <parent link="chassis"/>
        <child link="ir_sensor_1"/>
        <origin xyz="0.2 0.1 0" rpy="0 0 0"/>
    </joint>

    <link name="ir_sensor_2"/>
    <joint name="ir_2_joint" type="fixed">
        <parent link="chassis"/>
        <child link="ir_sensor_2"/>
        <origin xyz="0.2 -0.1 0" rpy="0 0 0"/>
    </joint>

    <link name="ir_sensor_3"/>
    <joint name="ir_3_joint" type="fixed">
        <parent link="chassis"/>
        <child link="ir_sensor_3"/>
        <origin xyz="-0.2 0.1 0" rpy="0 0 0"/>
    </joint>

    <link name="ir_sensor_4"/>
    <joint name="ir_4_joint" type="fixed">
        <parent link="chassis"/>
        <child link="ir_sensor_4"/>
        <origin xyz="-0.2 -0.1 0" rpy="0 0 0"/>
    </joint>

    <!-- SERVO 1 (Front) -->
    <link name="servo_1_link"/>
    <joint name="servo_1_joint" type="continuous">
        <parent link="chassis"/>
        <child link="servo_1_link"/>
        <origin xyz="0.2 0.0 0.1" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <!-- SERVO 2 (Rear) -->
    <link name="servo_2_link"/>
    <joint name="servo_2_joint" type="continuous">
        <parent link="chassis"/>
        <child link="servo_2_link"/>
        <origin xyz="-0.2 0.0 0.1" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <!-- REAL HARDWARE (Arduino ros2_control: LEFT/RIGHT) -->
    <xacro:unless value="$(arg use_sim)">
        <ros2_control name="ArduinoLeft" type="system">
            <hardware>
                <plugin>arduino_hardware_interface/ArduinoHardwareInterface</plugin>
                <param name="serial_port">/dev/ttyNANO_L</param>
                <param name="baudrate">115200</param>
            </hardware>

            <joint name="rear_left_wheel_joint">
                <command_interface name="velocity"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <param name="direction_multiplier">1</param>
            </joint>
            <joint name="front_left_wheel_joint">
                <command_interface name="velocity"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <param name="direction_multiplier">1</param>
            </joint>

            <joint name="servo_1_joint">
                <command_interface name="position"/>
                <state_interface name="position"/>
            </joint>

            <sensor name="imu_sensor_L">
                <state_interface name="orientation.x"/>
                <state_interface name="orientation.y"/>
                <state_interface name="orientation.z"/>
                <state_interface name="orientation.w"/>
                <state_interface name="angular_velocity.x"/>
                <state_interface name="angular_velocity.y"/>
                <state_interface name="angular_velocity.z"/>
                <state_interface name="linear_acceleration.x"/>
                <state_interface name="linear_acceleration.y"/>
                <state_interface name="linear_acceleration.z"/>
            </sensor>
            <sensor name="ir_sensor_1">
                <state_interface name="range"/>
            </sensor>
            <sensor name="ir_sensor_2">
                <state_interface name="range"/>
            </sensor>
        </ros2_control>

        <ros2_control name="ArduinoRight" type="system">
            <hardware>
                <plugin>arduino_hardware_interface/ArduinoHardwareInterface</plugin>
                <param name="serial_port">/dev/ttyAMA2</param>
                <param name="baudrate">115200</param>
            </hardware>

            <joint name="rear_right_wheel_joint">
                <command_interface name="velocity"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <param name="direction_multiplier">-1</param>
            </joint>
            <joint name="front_right_wheel_joint">
                <command_interface name="velocity"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <param name="direction_multiplier">-1</param>
            </joint>

            <joint name="servo_2_joint">
                <command_interface name="position"/>
                <state_interface name="position"/>
            </joint>

            <sensor name="imu_sensor_R">
                <state_interface name="orientation.x"/>
                <state_interface name="orientation.y"/>
                <state_interface name="orientation.z"/>
                <state_interface name="orientation.w"/>
                <state_interface name="angular_velocity.x"/>
                <state_interface name="angular_velocity.y"/>
                <state_interface name="angular_velocity.z"/>
                <state_interface name="linear_acceleration.x"/>
                <state_interface name="linear_acceleration.y"/>
                <state_interface name="linear_acceleration.z"/>
            </sensor>
            <sensor name="ir_sensor_3">
                <state_interface name="range"/>
            </sensor>
            <sensor name="ir_sensor_4">
                <state_interface name="range"/>
            </sensor>
        </ros2_control>
    </xacro:unless>

    <!-- SIMULATION (Gazebo Plugins) -->
    <xacro:if value="$(arg use_sim)">
        <gazebo>
            <!-- <plugin filename="gz-sim-mecanum-drive-system" name="gz::sim::systems::MecanumDrive">
                <front_left_joint>front_left_wheel_joint</front_left_joint>
                <front_right_joint>front_right_wheel_joint</front_right_joint>
                <back_left_joint>rear_left_wheel_joint</back_left_joint>
                <back_right_joint>rear_right_wheel_joint</back_right_joint>
                <wheelbase>${wheelbase}</wheelbase>
                <wheel_separation>${wheel_separation}</wheel_separation>
                <wheel_radius>${wheel_radius}</wheel_radius>
                <odom_publish_frequency>50</odom_publish_frequency>
                <topic>/cmd_vel</topic>
                <odom_topic>/odom</odom_topic>
                <tf_topic>/tf</tf_topic>
                <frame_id>odom</frame_id>
                <child_frame_id>base_link</child_frame_id>
            </plugin> -->
            <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
                <odom_frame>odom</odom_frame>
                <robot_base_frame>base_link</robot_base_frame>
                <odom_topic>/odometry/wheel</odom_topic>
                <!-- The EKF, rather than raw simulation, owns odom to base_link. -->
                <tf_topic>/odometry/wheel_tf</tf_topic>
                <odom_publish_frequency>50</odom_publish_frequency>
            </plugin>

            <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
                <topic>/cmd_vel</topic>
            </plugin>
            <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
                <topic>/joint_states</topic>
                <joint>front_left_wheel_joint</joint>
                <joint>front_right_wheel_joint</joint>
                <joint>rear_left_wheel_joint</joint>
                <joint>rear_right_wheel_joint</joint>
            </plugin>
        </gazebo>

        <gazebo reference="imu_sensor_L">
            <sensor name="imu_sensor_L_sim" type="imu">
                <always_on>true</always_on>
                <update_rate>50</update_rate>
                <topic>/imu_sensor_L_broadcaster/imu</topic>
                <gz_frame_id>imu_sensor_L</gz_frame_id>
                <imu>
                    <angular_velocity>
                        <x><noise type="gaussian"><mean>0.0</mean><stddev>0.002</stddev></noise></x>
                        <y><noise type="gaussian"><mean>0.0</mean><stddev>0.002</stddev></noise></y>
                        <z><noise type="gaussian"><mean>0.0</mean><stddev>0.002</stddev></noise></z>
                    </angular_velocity>
                    <linear_acceleration>
                        <x><noise type="gaussian"><mean>0.0</mean><stddev>0.02</stddev></noise></x>
                        <y><noise type="gaussian"><mean>0.0</mean><stddev>0.02</stddev></noise></y>
                        <z><noise type="gaussian"><mean>0.0</mean><stddev>0.02</stddev></noise></z>
                    </linear_acceleration>
                </imu>
            </sensor>
        </gazebo>

        <gazebo reference="imu_sensor_R">
            <sensor name="imu_sensor_R_sim" type="imu">
                <always_on>true</always_on>
                <update_rate>50</update_rate>
                <topic>/imu_sensor_R_broadcaster/imu</topic>
                <gz_frame_id>imu_sensor_R</gz_frame_id>
                <imu>
                    <angular_velocity>
                        <x><noise type="gaussian"><mean>0.0</mean><stddev>0.002</stddev></noise></x>
                        <y><noise type="gaussian"><mean>0.0</mean><stddev>0.002</stddev></noise></y>
                        <z><noise type="gaussian"><mean>0.0</mean><stddev>0.002</stddev></noise></z>
                    </angular_velocity>
                    <linear_acceleration>
                        <x><noise type="gaussian"><mean>0.0</mean><stddev>0.02</stddev></noise></x>
                        <y><noise type="gaussian"><mean>0.0</mean><stddev>0.02</stddev></noise></y>
                        <z><noise type="gaussian"><mean>0.0</mean><stddev>0.02</stddev></noise></z>
                    </linear_acceleration>
                </imu>
            </sensor>
        </gazebo>

        <gazebo reference="laser_frame">
            <sensor name="gpu_lidar" type="gpu_lidar">
                <pose>0 0 0 0 0 0</pose>
                <always_on>true</always_on>
                <update_rate>${lidar_update_rate}</update_rate>
                <visualize>false</visualize>
                <topic>/scan</topic>
                <gz_frame_id>laser_frame</gz_frame_id>
                <lidar>
                    <scan>
                        <horizontal>
                            <samples>${lidar_samples}</samples>
                            <resolution>1</resolution>
                            <min_angle>${lidar_min_angle}</min_angle>
                            <max_angle>${lidar_max_angle}</max_angle>
                        </horizontal>
                    </scan>
                    <range>
                        <min>${lidar_min_range}</min>
                        <max>${lidar_max_range}</max>
                        <resolution>0.01</resolution>
                    </range>
                    <noise>
                        <type>gaussian</type>
                        <mean>0.0</mean>
                        <stddev>${lidar_noise_stddev}</stddev>
                    </noise>
                </lidar>
            </sensor>
        </gazebo>

        <!-- Gazebo camera rays use the camera-link convention (+X forward).
             Messages are labelled with the ROS optical frame. -->
        <gazebo reference="camera_link">
            <sensor name="front_camera" type="camera">
                <pose>0 0 0 0 0 0</pose>
                <always_on>true</always_on>
                <update_rate>${camera_update_rate}</update_rate>
                <visualize>false</visualize>
                <topic>/camera/image_raw</topic>
                <gz_frame_id>camera_optical_frame</gz_frame_id>
                <camera>
                    <horizontal_fov>1.0856</horizontal_fov>
                    <image>
                        <width>640</width>
                        <height>480</height>
                        <format>R8G8B8</format>
                    </image>
                    <clip>
                        <near>0.05</near>
                        <far>20.0</far>
                    </clip>
                    <camera_info_topic>/camera/camera_info</camera_info_topic>
                </camera>
            </sensor>
        </gazebo>
    </xacro:if>

</robot>
